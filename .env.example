# ===========================================================================
# AMIRIANI — environment
#
# Copy to `.env.local` and fill in. Nothing here is a real secret.
#
# The split below is the important part:
#
#   NEXT_PUBLIC_*   compiled into the JavaScript bundle. Anyone can read them.
#                   Only put values here that are safe to publish.
#   everything else server-only. Read through lib/env.ts, which throws if a
#                   secret is ever reached from browser code, so a leak becomes
#                   a crash instead of a silent exposure.
# ===========================================================================


# ===========================================================================
# BROWSER-SAFE  (shipped to the client — never put a secret in this section)
# ===========================================================================

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The publishable ("anon") key. Safe to publish: it carries no privileges of
# its own, and every table it can reach is gated by Row Level Security. If RLS
# were ever disabled on a table this key would read it, which is why
# `npm run supabase:verify` fails the build when a table has RLS off.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical origin. Used for metadata, canonical tags, sitemap URLs, and the
# Stripe success/cancel return URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://amiriani.com


# ===========================================================================
# SERVER-ONLY  (must never be prefixed NEXT_PUBLIC_)
# ===========================================================================

# Service role key. Bypasses RLS completely — it is the database's root
# password in HTTP form. Used only by route handlers and scripts. If this ever
# reaches the browser, rotate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe secret key. Use a test key (sk_test_...) until you go live.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# prints one for local use; in production copy it from the endpoint you create
# in the Stripe dashboard. Without it every event is rejected and no order is
# ever marked paid, so this is not optional in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Subtotal (in cents) at which the cheaper delivery option unlocks.
# The rates themselves are NOT configurable — they are transcribed from the
# reference store's live checkout into src/lib/shipping.ts, because guessing
# them means charging customers the wrong amount. Only this threshold lives
# here, since it was the one value the public API would not reveal exactly.
FREE_SHIPPING_THRESHOLD_CENTS=19990


# ===========================================================================
# SERVER-ONLY — migration and operations scripts
#
# Not needed to run the site. Only the one-off tooling reads these.
# ===========================================================================

# Postgres connection string. Used by supabase:apply, supabase:verify,
# stripe:verify and commerce:verify — never by the application itself.
# Supabase dashboard → Project Settings → Database → Connection string → URI.
# Use port 5432 (session pooler or direct). Port 6543 is the transaction
# pooler and cannot run DDL, so migrations will fail against it.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Source store, read by the extract script only.
SHOPIFY_STORE_URL=https://7t6swe-yh.myshopify.com

# Pins the Shopify market so extracted prices match what the storefront shows.
# Shopify varies prices by market, and an unpinned extract silently pulls the
# wrong currency's numbers.
SHOPIFY_MARKET_COUNTRY=BE

# storage = download images into Supabase Storage (required before cutover, so
#           the store stops depending on the Shopify CDN)
# external = keep the source URLs (faster; development only)
IMAGE_STRATEGY=storage

# Path to a Shopify admin product export CSV. This is what carries the real
# inventory counts, SKUs, barcodes, cost prices, weights and SEO fields —
# none of which the public storefront API exposes.
# Shopify admin → Products → Export → "All products", "Plain CSV file".
# SHOPIFY_CSV=./products_export.csv

# By default a re-import LEAVES EXISTING STOCK ALONE for any variant the CSV
# does not give a number for, so re-running the importer cannot silently wipe
# live inventory. Set this to 1 only for a deliberate reset to placeholder
# counts on a development database.
# OVERWRITE_INVENTORY=1
