# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and the publishable (anon) key. Both are safe in the browser:
# every table they can reach is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role key. Bypasses RLS entirely — server-only.
# Never prefix this with NEXT_PUBLIC_, and never import it into a Client
# Component; lib/env.ts throws if it is read in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin, used for metadata, sitemap URLs and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=https://amiriani.com

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Without it the webhook rejects every event, and orders are never
# marked paid.
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Shipping (server-side; the browser never supplies these)
# ---------------------------------------------------------------------------
SHIPPING_FLAT_RATE_CENTS=495
FREE_SHIPPING_THRESHOLD_CENTS=10000

# ---------------------------------------------------------------------------
# Migration (only needed when running the import scripts)
# ---------------------------------------------------------------------------
SHOPIFY_STORE_URL=https://7t6swe-yh.myshopify.com
# Pins the Shopify market so prices match what the storefront shows.
SHOPIFY_MARKET_COUNTRY=BE
# storage = download images into Supabase Storage; external = keep source URLs.
IMAGE_STRATEGY=storage
# Path to a Shopify admin product export CSV, to import real inventory counts.
# INVENTORY_CSV=./products_export.csv
